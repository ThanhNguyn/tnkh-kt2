  {
    "id": "parseSensor",
    "type": "function",
    "z": "tab1",
    "name": "Parse Sensor JSON",
    "func": "let data = msg.payload;\n\nif (Buffer.isBuffer(data)) {\n    data = data.toString();\n}\n\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        node.warn(\"Invalid MQTT JSON: \" + data);\n        return null;\n    }\n}\n\nconst temperature = Number(data.temperature);\nconst humidity = Number(data.humidity);\n\nif (!Number.isFinite(temperature) || !Number.isFinite(humidity)) {\n    node.warn(\"Invalid temperature/humidity values\");\n    return null;\n}\n\nconst sensor = {\n    temperature: temperature,\n    humidity: humidity,\n    unit_temperature: \"C\",\n    unit_humidity: \"%\",\n    mqtt_topic: \"tnkh/week4/esp32/sensor\",\n    updated_at: new Date().toISOString()\n};\n\nflow.set(\"latestSensor\", sensor);\n\nreturn [\n    {\n        topic: \"temperature\",\n        payload: temperature\n    },\n    {\n        topic: \"humidity\",\n        payload: humidity\n    }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 100,
    "wires": [
      [
        "tempChart",
        "tempGauge"
      ],
      [
        "humChart",
        "humGauge"
      ]
    ]
  },
