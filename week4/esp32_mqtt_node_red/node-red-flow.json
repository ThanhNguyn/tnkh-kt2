    "type": "mqtt in",
    "z": "tab1",
    "name": "ESP32 Sensor",
    "topic": "tnkh/week4/esp32/sensor",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker1",
    "nl": false,
    "rap": true,
