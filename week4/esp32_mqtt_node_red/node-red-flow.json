  {
    "id": "httpFunction",
    "type": "function",
    "z": "tab1",
    "name": "Return Sensor JSON",
    "func": "const sensor = flow.get(\"latestSensor\");\n\nmsg.headers = {\n    \"Content-Type\": \"application/json; charset=utf-8\",\n    \"Cache-Control\": \"no-store\",\n    \"Access-Control-Allow-Origin\": \"*\"\n};\n\nif (!sensor) {\n    msg.statusCode = 503;\n    msg.payload = {\n        error: \"waiting_for_sensor_data\",\n        message: \"Waiting for ESP32 MQTT sensor data...\"\n    };\n} else {\n    msg.statusCode = 200;\n    msg.payload = sensor;\n}\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 560,
    "wires": [
