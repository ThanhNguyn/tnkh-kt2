    "y": 40,
    "wires": []
  },
  {
    "id": "in_sensor",
    "type": "mqtt in",
    "z": "th5_tab",
    "name": "sensor (JSON)",
    "topic": "tnkh/th5/esp32/sensor",
    "qos": "1",
    "datatype": "json",
    "broker": "th5_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 100,
    "wires": [
      [
        "fn_split"
      ]
    ]
  },
  {
    "id": "fn_split",
    "type": "function",
    "z": "th5_tab",
    "name": "Dedupe + split",
    "func": "// Input: {boot, seq, ts, t, h, replayed}\nconst d = msg.payload;\nif (!d || typeof d.t !== 'number' || typeof d.h !== 'number' ||\n    d.seq === undefined || d.boot === undefined) {\n    node.warn('Ignoring malformed sample');\n    return null;\n}\n\n// De-duplicate on (boot, seq): the device may replay samples after an outage.\nconst key = d.boot + ':' + d.seq;\nlet seen = context.get('seen') || [];\nif (seen.indexOf(key) !== -1) { return null; }\nseen.push(key);\nif (seen.length > 1000) { seen.shift(); }\ncontext.set('seen', seen);\n\n// Use the device timestamp when its clock was synced (0 means \"unknown\").\nconst ts = d.ts ? d.ts * 1000 : Date.now();\nconst live = !d.replayed;\nconst THRESHOLD = flow.get('tempThreshold') || 35;\n\nconst tempMsg = live ? { payload: d.t } : null;\nconst humMsg  = live ? { payload: d.h } : null;\nconst chart = [\n    { topic: 'Temperature', payload: d.t, timestamp: ts },\n    { topic: 'Humidity',    payload: d.h, timestamp: ts }\n];\n// CSV columns: iso_time,temperature_c,humidity_pct,replayed\nconst csv = { payload: new Date(ts).toISOString() + ',' + d.t + ',' + d.h + ',' + (d.replayed ? 1 : 0) };\n// Alerts only for live samples so old buffered data cannot raise a false alarm.\nlet alert = null;\nif (live) {\n    alert = { payload: d.t > THRESHOLD\n        ? '\\u26a0 HIGH TEMPERATURE ' + d.t.toFixed(1) + ' \\u00b0C (limit ' + THRESHOLD + ' \\u00b0C)'\n        : 'Temperature normal' };\n}\nreturn [tempMsg, humMsg, chart, csv, alert];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 100,
    "wires": [
      [
        "ui_temp"
      ],
      [
        "ui_hum"
      ],
      [
        "ui_chart"
      ],
      [
        "file_csv"
      ],
      [
        "ui_alert"
      ]
    ]
  },
