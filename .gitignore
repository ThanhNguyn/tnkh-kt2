# =====================================================================
# Master .gitignore — chỉ cần file này, áp dụng cho MỌI project / MỌI tuần
# (pattern không bắt đầu bằng "/" nên match ở mọi cấp thư mục)
# =====================================================================

# --- PlatformIO: build output + libs tự sinh (mọi env, mọi project) ---
.pio/
.pioenvs/
.piolibdeps/
.cache/
.dummy/
compile_commands.json

# --- VS Code: cấu hình workspace mỗi máy tự sinh ---
.vscode/

# --- Firmware / build artifact (nếu bị copy ra ngoài .pio/) ---
*.bin
*.elf
*.map
*.hex

# --- Hệ điều hành tự sinh ---
.DS_Store
Thumbs.db
desktop.ini

# --- Python: script vẽ đồ thị / xử lý dữ liệu (nếu dùng) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.matplotlib/
